{
  "name": "perfect-season",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "data": "python3 scripts/build_nba_data.py && python3 scripts/build_nfl_data.py",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run && PS_SPORT=nfl vitest run",
    "typecheck": "tsc --noEmit",
    "data:registry": "vite-node scripts/build_registry_catalog.ts",
    "audit:ratings": "vite-node scripts/audit_ut_ratings.ts",
    "data:numbered": "vite-node scripts/build_numbered_catalog.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "nostr-tools": "^2.25.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.4"
  }
}
